{
  "name": "@deepseek-ai/dsh-experimental-tool-witr",
  "version": "1.0.0",
  "description": "DeepSeek Harness plugin providing model-facing witr causal process, port, and lock tracing tools",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --project tsconfig.test.json",
    "test": "vitest run",
    "prepare": "tsc"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "cordis",
    "plugin",
    "witr",
    "process-tracing",
    "port-tracing"
  ],
  "author": "Martin M <martinm86867@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinm86867-ops/dsh-plugin-witr.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-alpha.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-alpha.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
